# ==========================================
# Environment Variables Template - TeFa PPLG SMKN 2 Surakarta
# ==========================================

# 1. Aplikasi & Metadata Publik
NEXT_PUBLIC_APP_NAME="TeFa PPLG SMKN 2 Surakarta"
NEXT_PUBLIC_SCHOOL_NAME="SMK Negeri 2 Surakarta"
NEXT_PUBLIC_APP_URL="https://tefa.smkn2surakarta.sch.id"

# 2. Nomor WhatsApp Penerima Lead Briefs (Format: 628xxxxxxxxxx)
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"

# 3. Database Connection String (Neon Postgres Serverless)
DATABASE_URL="postgres://user:password@ep-sample-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# 4. Authentication (Better Auth)
BETTER_AUTH_SECRET="your-32-character-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# 5. Cloudflare R2 Object Storage (File Upload Screenshot Admin)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="tefa-showcase-storage"
R2_PUBLIC_URL="https://pub-sample.r2.dev"

# 6. Alternatif Object Storage S3-Compatible (Misal: MinIO / Garage di VPS Coolify)
# S3_ENDPOINT="https://s3.domain-vps-anda.com"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="minio-access-key"
# S3_SECRET_ACCESS_KEY="minio-secret-key"
# S3_BUCKET_NAME="tefa-showcase-storage"
# S3_PUBLIC_URL="https://s3.domain-vps-anda.com/tefa-showcase-storage"

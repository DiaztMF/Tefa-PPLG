# ==========================================
# Environment Variables Template - TeFa PPLG SMKN 2 Surakarta
# ==========================================

# 1. Aplikasi & Metadata Publik
NEXT_PUBLIC_APP_NAME="TeFa PPLG SMKN 2 Surakarta"
NEXT_PUBLIC_SCHOOL_NAME="SMK Negeri 2 Surakarta"
NEXT_PUBLIC_APP_URL="https://tefa.smkn2surakarta.sch.id"

# 2. Nomor WhatsApp Penerima Lead Briefs (Format: 628xxxxxxxxxx)
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"

# 3. Database Connection String (Neon Postgres Serverless)
# Dapatkan string koneksi ini dari Dashboard Neon Postgres (neon.tech)
DATABASE_URL="postgres://user:password@ep-sample-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# 4. Authentication (Better Auth)
# Generate secret key acak dengan perintah `openssl rand -hex 32`
BETTER_AUTH_SECRET="your-32-character-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
